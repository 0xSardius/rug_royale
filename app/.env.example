# Copy to app/.env.local (and set the same in Vercel's project settings).
#
# Server-only: the browser calls /api/rpc, which forwards here. Put your Helius (or other
# keyed) URL in THIS variable. It is never sent to the client.
RPC_URL=https://api.devnet.solana.com
#
# Public WebSocket for transaction confirmations. Must NOT contain an API key: every
# NEXT_PUBLIC_* value is inlined into the JavaScript every visitor downloads.
NEXT_PUBLIC_WS_URL=wss://api.devnet.solana.com
#
# Do NOT set NEXT_PUBLIC_RPC_URL anymore (it used to carry the Helius key into the bundle).
#
# Optional: shared rate limit for /api/rpc across all server instances (Upstash Redis, free
# tier). Without these, each instance limits on its own. RPC_RATE_LIMIT = cost units per IP
# per minute (default 300; getProgramAccounts costs 10).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RPC_RATE_LIMIT=300
