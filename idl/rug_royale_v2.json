            "type": {
              "array": [
                "u32",
                4
              ]
            }
          },
          {
            "name": "bankroll",
            "type": "u64"
          },
          {
            "name": "min_entry_lamports",
            "type": "u64"
          },
          {
            "name": "max_entry_lamports",
            "type": "u64"
          },
          {
            "name": "trade_fee_bps",
            "type": "u16"
          },
          {
            "name": "rake_bps",
            "type": "u16"
          },
          {
            "name": "max_price_age_s",
            "type": "u32"
          },
