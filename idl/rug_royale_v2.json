  "types": [
    {
      "name": "Arena",
      "docs": [
        "Seeds `[\"arena\", arena_id.to_le_bytes()]`. Base only; cloned read-only into the ER."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "arena_id",
            "type": "u16"
          },
          {
            "name": "mode",
            "docs": [
              "0 = LIVE_PRICE_DUEL."
            ],
            "type": "u8"
          },
          {
            "name": "paused",
            "docs": [
              "Blocks create/join only."
            ],
            "type": "bool"
          },
          {
            "name": "asset_count",
            "docs": [
              "1..=MAX_ASSETS; entries at index >= asset_count are zeroed."
            ],
            "type": "u8"
          },
          {
            "name": "assets",
            "type": {
              "array": [
                {
                  "defined": {
                    "name": "ArenaAsset"
                  }
                },
                10
              ]
            }
          },
          {
            "name": "windows",
            "docs": [
              "Seconds, a non-zero ascending prefix; 0 = unused slot."
            ],
            "type": {
              "array": [
                "u32",
                4
              ]
            }
          },
          {
            "name": "bankroll",
            "docs": [
              "Virtual bankroll per seat, micro-USD."
            ],
            "type": "u64"
          },
          {
            "name": "min_entry_lamports",
            "type": "u64"
          },
          {
            "name": "max_entry_lamports",
            "type": "u64"
          },
          {
            "name": "trade_fee_bps",
            "type": "u16"
          },
          {
            "name": "rake_bps",
            "type": "u16"
          },
          {
            "name": "max_price_age_s",
            "type": "u32"
          },
          {
            "name": "start_delay_secs",
            "docs": [
              "Q2: delay from join to the start of trading."
            ],
            "type": "u16"
          },
          {
            "name": "freeroll_daily_cap",
            "docs": [
              "D4: sponsored freerolls per wallet per day."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ArenaArgs",
      "docs": [
        "Every `Arena` field except `arena_id` (seed), `mode` (always LIVE_PRICE_DUEL in v2.1)",
        "and `bump`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "paused",
            "type": "bool"
          },
          {
            "name": "asset_count",
            "type": "u8"
          },
          {
            "name": "assets",
            "type": {
              "array": [
                {
                  "defined": {
                    "name": "ArenaAsset"
                  }
                },
                10
              ]
            }
          },
          {
